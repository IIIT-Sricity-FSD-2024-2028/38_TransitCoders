  "info": {
    "title": "SwiftTrack Backend API",
    "description": "NestJS backend for the SwiftTrack logistics platform",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "x-auth-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-auth-token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Shreesaanth R"
          },
          "email": {
            "type": "string",
            "example": "shreesaanth@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6,
            "description": "Minimum 6 characters"
          },
          "role": {
            "type": "string",
            "enum": [
              "super_user",
              "hub_manager",
              "merchant",
              "delivery_agent",
              "customer"
            ],
            "example": "customer",
            "description": "Role for the new account"
          },
          "phone": {
            "type": "string",
            "example": "+91-9876543210"
          },
          "company": {
            "type": "string",
            "example": "Acme Corp",
            "description": "Required when role is merchant"
          },
          "hubId": {
            "type": "string",
            "example": "H001",
            "description": "Required when role is hub_manager or delivery_agent"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "super@swifttrack.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Shazil Mirza"
          },
          "email": {
            "type": "string",
            "example": "shazil@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          },
          "role": {
            "type": "string",
            "enum": [
              "super_user",
              "hub_manager",
              "merchant",
              "delivery_agent",
              "customer"
            ],
            "example": "merchant"
          },
          "hubId": {
            "type": "string",
            "example": "H001"
          },
          "phone": {
            "type": "string",
            "example": "+91-9876543210"
          },
          "company": {
            "type": "string",
            "example": "Acme Corp"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Shazil Mirza"
          },
          "email": {
            "type": "string",
            "example": "shazil@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          },
          "role": {
            "type": "string",
            "enum": [
              "super_user",
              "hub_manager",
              "merchant",
              "delivery_agent",
              "customer"
            ],
            "example": "merchant"
          },
          "hubId": {
            "type": "string",
            "example": "H001"
          },
          "phone": {
            "type": "string",
            "example": "+91-9876543210"
          },
          "company": {
            "type": "string",
            "example": "Acme Corp"
          }
        }
      },
      "CreateTicketDto": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "example": "Order not delivered on time"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "med",
              "high"
            ],
            "example": "med"
          },
          "trackingId": {
            "type": "string",
            "example": "ST-100002"
          }
        },
        "required": [
          "subject",
          "priority"
        ]
      },
      "UpdateTicketDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in-progress",
              "resolved",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "med",
              "high"
            ]
          }
        }
      },
      "ComplaintResponseDto": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "example": "cmp-0001"
          },
          "id": {
            "type": "string",
            "example": "42099a94-8c60-4f94-b408-908238188aa5"
          },
          "customerName": {
            "type": "string",
            "example": "Priya Iyer"
          },
          "orderId": {
            "type": "string",
            "example": "ORD-2024-0006"
          },
          "description": {
            "type": "string",
            "example": "Ordered Sony headphones but received wrong brand."
          },
          "status": {
            "type": "string",
            "example": "In Progress"
          },
          "createdAt": {
            "type": "object",
            "example": "May 5"
          },
          "updatedAt": {
            "type": "object",
            "example": "May 6"
          }
        },
        "required": [
          "reference",
          "id",
          "customerName",
          "orderId",
          "description",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateComplaintDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "My order was damaged on delivery"
          },
          "orderId": {
            "type": "string",
            "example": "ORD_5"
          }
        },
        "required": [
          "description"
        ]
      },
      "UpdateComplaintDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "In Progress",
              "Resolved"
            ]
          }
        }
      },
      "FeedbackResponseDto": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "example": "fbk-0001"
          },
          "id": {
            "type": "string",
            "example": "8f3b2a1d-9c4a-4a7c-9d3c-1b2a3c4d5e6f"
          },
          "customerName": {
            "type": "string",
            "example": "John Doe"
          },
          "rating": {
            "type": "number",
            "example": 4
          },
          "comment": {
            "type": "string",
            "example": "Delivery was fast and courteous."
          },
          "status": {
            "type": "string",
            "example": "New"
          },
          "createdAt": {
            "type": "object",
            "example": "May 5"
          }
        },
        "required": [
          "reference",
          "id",
          "customerName",
          "rating",
          "comment",
          "status",
          "createdAt"
        ]
      },
      "CreateFeedbackDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "example": 4,
            "minimum": 1,
            "maximum": 5
          },
          "orderId": {
            "type": "string",
            "example": "ORD_3"
          },
          "comments": {
            "type": "string",
            "example": "Great service, fast delivery!"
          }
        },
        "required": [
          "rating"
        ]
      },
      "UpdateFeedbackDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "New",
              "Reviewed",
              "Actioned"
            ]
          }
        }
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "object",
            "description": "Permission map — only boolean values allowed",
            "example": {
              "view_users": true,
              "create_orders": false,
              "manage_hubs": true
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "UpdateAvailabilityDto": {
        "type": "object",
        "properties": {}
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateOrderDto": {
        "type": "object",
        "properties": {}
      },
      "AssignAgentDto": {
        "type": "object",
        "properties": {}
      },
      "CreateHubDto": {
        "type": "object",
        "properties": {
          "hubId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "pincode": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "managerId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "maintenance"
            ]
          },
          "capacity": {
            "type": "number"
          }
        },
        "required": [
          "hubId",
          "name",
          "address",
          "city",
          "state",
          "pincode"
        ]
      },
      "UpdateHubDto": {
        "type": "object",
        "properties": {}
      },
      "CreateShipmentDto": {
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string",
            "description": "Name of the recipient"
          },
          "originHubId": {
            "type": "string"
          },
          "destinationHubId": {
            "type": "string"
          },
          "serviceType": {
            "type": "string",
            "enum": [
              "standard",
              "express",
              "same-day"
            ]
          },
          "weight": {
            "type": "number"
          },
          "merchantId": {
            "type": "string"
          }
        },
        "required": [
          "originHubId",
          "destinationHubId",
          "serviceType",
          "weight"
        ]
      },
      "UpdateShipmentDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
